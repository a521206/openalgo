// Rajandran R - Creator of OpenAlgo
// Website - openalgo.in / marketcalls.in
// OpenAlgo - Amibroker SmartOrder Chart Trading Module v2.0
// Added: Scale Out functionality (Percentage / Quantity modes)
// Date - 11/06/2026

_SECTION_BEGIN( "OpenAlgo SmartOrder Trading Module v2.0" );

RequestTimedRefresh( 1, False );

//  Parameters 
VoiceAlert   = ParamToggle( "Voice Alert",    "Disable|Enable", 1 );
EnableAlgo   = ParamToggle( "Algo Mode",      "Disable|Enable", 1 );

ScaleOutMode = ParamList( "Scale Out Mode",   "Disable|Percentage|Quantity", 0 );
ScaleOutPct  = Param(     "Scale Out %",      50, 5, 95, 5  );
ScaleOutLots = Param(     "Scale Out Lots",   1,  1, 100, 1 );

pricetype     = "LIMIT";
product       = "NRML";
symbol        = underlying + expiry + "FUT";
quantity      = 0;
position_size = IIf( Buy, bLots, IIf( Short, -1 * sLots, 0 ) ) * RoundLotSize;

AlgoBuy           = LastValue( Buy );
AlgoSell          = LastValue( Sell );
AlgoShort         = LastValue( Short );
AlgoCover         = LastValue( Cover );
AlgoScaleOutLong  = LastValue( Buy )   == sigScaleOut;   // Scale out of long
AlgoScaleOutShort = LastValue( Short ) == sigScaleOut;   // Scale out of short

bridgeurl        = host + "/api/" + ver;
static_name_     = Name() + GetChartID() + interval( 2 ) + strategy;
static_name_algo = static_name_ + interval( 2 ) + strategy + "algostatus";

//  Dashboard 
GfxSelectFont( "BOOK ANTIQUA", 10, 100 );
GfxSetBkMode( 1 );

if( EnableAlgo )
{
    GfxSetTextColor( colorGreen );
    GfxTextOut( "Algo Enabled", 20, 40 );
    if( Nz( StaticVarGet( static_name_algo ), 0 ) != 1 )
    {
        _TRACE( "Algo Status : Enabled" );
        StaticVarSet( static_name_algo, 1 );
    }
}

if( NOT EnableAlgo )
{
    GfxSetTextColor( colorRed );
    GfxTextOut( "Algo Disabled", 20, 40 );
    if( Nz( StaticVarGet( static_name_algo ), 0 ) != 0 )
    {
        _TRACE( "Algo Status : Disabled" );
        StaticVarSet( static_name_algo, 0 );
    }
}

// Scale Out info line
GfxSelectFont( "BOOK ANTIQUA", 9, 400 );
GfxSetTextColor( colorDarkGrey );
scale_info = "Scale Out: " + ScaleOutMode;
if( ScaleOutMode == "Percentage" ) scale_info = scale_info + " (" + NumToStr( ScaleOutPct,  1.0, False ) + "%)";
if( ScaleOutMode == "Quantity"   ) scale_info = scale_info + " (" + NumToStr( ScaleOutLots, 1.0, False ) + " lots)";
GfxTextOut( scale_info, 20, 60 );

//  Button plumbing (unchanged from v1) 
X0 = 20; Y0 = 100; X1 = 60;
LBClick = GetCursorMouseButtons() == 9;
MouseX  = Nz( GetCursorXPosition( 1 ) );
MouseY  = Nz( GetCursorYPosition( 1 ) );

procedure DrawButton( Text, x1, y1, x2, y2, colorFrom, colorTo )
{
    GfxSetOverlayMode( 0 );
    GfxSelectFont( "BOOK ANTIQUA", 10, 100 );
    GfxSetBkMode( 1 );
    GfxGradientRect( x1, y1, x2, y2, colorFrom, colorTo );
    GfxDrawText( Text, x1, y1, x2, y2, 32 | 1 | 4 | 16 );
}
GfxSetTextColor( colorWhite );

//  Order Functions 
function PlaceSmartOrder( action, qty, pos_size )
{
    postData = "{\"apikey\": \"" + apikey + "\", " +
               "\"strategy\": \"" + strategy + "\", " +
               "\"symbol\": \"" + symbol + "\", " +
               "\"action\": \"" + action + "\", " +
               "\"exchange\": \"" + exchange + "\", " +
               "\"pricetype\": \"" + pricetype + "\", " +
               "\"product\": \"" + product + "\", " +
               "\"quantity\": \"" + qty + "\", " +
               "\"position_size\": \"" + pos_size + "\"}";

    headers = "Content-Type: application/json\r\nAccept-Encoding: gzip, deflate\r\n";
    InternetSetHeaders( headers );
    _TRACE( "Order Request Sent: " + postData );
    ih = InternetPostRequest( bridgeurl + "/placesmartorder", postData );
    if( ih )
    {
        response = "";
        while( ( line = InternetReadString( ih ) ) != "" ) response += line;
        _TRACEF( "Order Response: %s", response );
        if( VoiceAlert ) Say( action + " Order Placed." );
        InternetClose( ih );
    }
    else _TRACE( "Failed to place order." );
}

function ExitOrder( action )
{
    postData = "{\"apikey\": \"" + apikey + "\", " +
               "\"strategy\": \"" + strategy + "\", " +
               "\"symbol\": \"" + symbol + "\", " +
               "\"action\": \"" + action + "\", " +
               "\"exchange\": \"" + exchange + "\", " +
               "\"pricetype\": \"" + pricetype + "\", " +
               "\"product\": \"" + product + "\", " +
               "\"quantity\": \"0\", " +
               "\"position_size\": \"0\"}";

    headers = "Content-Type: application/json\r\nAccept-Encoding: gzip, deflate\r\n";
    InternetSetHeaders( headers );
    _TRACE( "Exit Order Request Sent: " + postData );
    ih = InternetPostRequest( bridgeurl + "/placesmartorder", postData );
    if( ih )
    {
        response = "";
        while( ( line = InternetReadString( ih ) ) != "" ) response += line;
        _TRACEF( "Exit Order Response: %s", response );
        if( VoiceAlert ) Say( action + " Exit Order Placed." );
        InternetClose( ih );
    }
    else _TRACE( "Failed to place exit order." );
}

/* Scale Out: partial exit via scale_pct (Percentage mode) or scale_qty (Quantity mode).
   Sends quantity=0, position_size=0 plus the chosen scale parameter so the backend
   placesmartorder service reduces the open position by the requested amount.          */
function ScaleOrder( action, scale_pct_val, scale_qty_val )
{
    postData = "{\"apikey\": \"" + apikey + "\", " +
               "\"strategy\": \"" + strategy + "\", " +
               "\"symbol\": \"" + symbol + "\", " +
               "\"action\": \"" + action + "\", " +
               "\"exchange\": \"" + exchange + "\", " +
               "\"pricetype\": \"" + pricetype + "\", " +
               "\"product\": \"" + product + "\", " +
               "\"quantity\": \"0\", " +
               "\"position_size\": \"0\"";

    if( scale_pct_val > 0 )
        postData = postData + ", \"scale_pct\": \"" + NumToStr( scale_pct_val, 1.0, False ) + "\"";
    else
        if( scale_qty_val > 0 )
            postData = postData + ", \"scale_qty\": \"" + NumToStr( scale_qty_val, 1.0, False ) + "\"";

    postData = postData + "}";

    headers = "Content-Type: application/json\r\nAccept-Encoding: gzip, deflate\r\n";
    InternetSetHeaders( headers );
    _TRACE( "Scale Order Request Sent: " + postData );
    ih = InternetPostRequest( bridgeurl + "/placesmartorder", postData );
    if( ih )
    {
        response = "";
        while( ( line = InternetReadString( ih ) ) != "" ) response += line;
        _TRACEF( "Scale Order Response: %s", response );
        if( VoiceAlert ) Say( action + " Scale Out Order Placed." );
        InternetClose( ih );
    }
    else _TRACE( "Failed to place scale order." );
}

function SquareOffAll()
{
    postData = "{\"apikey\": \"" + apikey + "\", " +
               "\"strategy\": \"" + strategy + "\"}";

    headers = "Content-Type: application/json\r\nAccept-Encoding: gzip, deflate\r\n";
    InternetSetHeaders( headers );
    _TRACE( "Square Off Request Sent: " + postData );
    ih = InternetPostRequest( bridgeurl + "/closeposition", postData );
    if( ih )
    {
        response = "";
        while( ( line = InternetReadString( ih ) ) != "" ) response += line;
        _TRACEF( "Square Off Response: %s", response );
        if( VoiceAlert ) Say( "All positions squared off." );
        InternetClose( ih );
    }
    else _TRACE( "Failed to square off positions." );
}

//  Execution Module 
if( EnableAlgo )
{
    lasttime = StrFormat( "%0.f", LastValue( BarIndex() ) );

    //  Buy + Cover  (reversal: short → long) 
    if( AlgoBuy == True AND AlgoCover == True AND
            StaticVarGet( static_name_ + "buyCoverAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "buyCoverAlgo_barvalue" ) != lasttime )
    {
        PlaceSmartOrder( "BUY", quantity, quantity );
        if( VoiceAlert ) Say( "Buy Order Triggered" );
        StaticVarSetText( static_name_ + "buyCoverAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "buyCoverAlgo",          1 );
    }
    else
        if( AlgoBuy != True OR AlgoCover != True )
        {
            StaticVarSet(     static_name_ + "buyCoverAlgo",          0 );
            StaticVarSetText( static_name_ + "buyCoverAlgo_barvalue", "" );
        }

    //  Buy Only  (fresh long entry) 
    if( AlgoBuy == True AND AlgoCover != True AND
            StaticVarGet( static_name_ + "buyAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "buyAlgo_barvalue" ) != lasttime )
    {
        PlaceSmartOrder( "BUY", quantity, position_size );
        if( VoiceAlert ) Say( "Buy Order Triggered" );
        StaticVarSetText( static_name_ + "buyAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "buyAlgo",          1 );
    }
    else
        if( AlgoBuy != True )
        {
            StaticVarSet(     static_name_ + "buyAlgo",          0 );
            StaticVarSetText( static_name_ + "buyAlgo_barvalue", "" );
        }

    //  Sell Exit  (exit long) 
    if( AlgoSell == True AND AlgoShort != True AND
            StaticVarGet( static_name_ + "sellAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "sellAlgo_barvalue" ) != lasttime )
    {
        ExitOrder( "SELL" );
        if( VoiceAlert ) Say( "Sell Exit Order Triggered" );
        StaticVarSetText( static_name_ + "sellAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "sellAlgo",          1 );
        // Reset long scale-out latch on full exit
        StaticVarSet(     static_name_ + "scaleOutLongAlgo",          0 );
        StaticVarSetText( static_name_ + "scaleOutLongAlgo_barvalue", "" );
    }
    else
        if( AlgoSell != True )
        {
            StaticVarSet(     static_name_ + "sellAlgo",          0 );
            StaticVarSetText( static_name_ + "sellAlgo_barvalue", "" );
        }

    //  Short + Sell  (reversal: long → short) 
    if( AlgoShort == True AND AlgoSell == True AND
            StaticVarGet( static_name_ + "ShortSellAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "ShortSellAlgo_barvalue" ) != lasttime )
    {
        PlaceSmartOrder( "SELL", quantity, -1 * quantity );
        if( VoiceAlert ) Say( "Short Order Triggered" );
        StaticVarSetText( static_name_ + "ShortSellAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "ShortSellAlgo",          1 );
    }
    else
        if( AlgoShort != True OR AlgoSell != True )
        {
            StaticVarSet(     static_name_ + "ShortSellAlgo",          0 );
            StaticVarSetText( static_name_ + "ShortSellAlgo_barvalue", "" );
        }

    //  Short Only  (fresh short entry) 
    if( AlgoShort == True AND AlgoSell != True AND
            StaticVarGet( static_name_ + "ShortAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "ShortAlgo_barvalue" ) != lasttime )
    {
        PlaceSmartOrder( "SELL", quantity, position_size );
        if( VoiceAlert ) Say( "Short Order Triggered" );
        StaticVarSetText( static_name_ + "ShortAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "ShortAlgo",          1 );
    }
    else
        if( AlgoShort != True )
        {
            StaticVarSet(     static_name_ + "ShortAlgo",          0 );
            StaticVarSetText( static_name_ + "ShortAlgo_barvalue", "" );
        }

    //  Cover Exit  (exit short) 
    if( AlgoCover == True AND AlgoBuy != True AND
            StaticVarGet( static_name_ + "CoverAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "CoverAlgo_barvalue" ) != lasttime )
    {
        ExitOrder( "BUY" );
        if( VoiceAlert ) Say( "Short Exit Order Triggered" );
        StaticVarSetText( static_name_ + "CoverAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "CoverAlgo",          1 );
        // Reset short scale-out latch on full exit
        StaticVarSet(     static_name_ + "scaleOutShortAlgo",          0 );
        StaticVarSetText( static_name_ + "scaleOutShortAlgo_barvalue", "" );
    }
    else
        if( AlgoCover != True )
        {
            StaticVarSet(     static_name_ + "CoverAlgo",          0 );
            StaticVarSetText( static_name_ + "CoverAlgo_barvalue", "" );
        }

    //  Scale Out – Long Position  (Buy == sigScaleOut) 
    if( ScaleOutMode != "Disable" AND AlgoScaleOutLong AND
            StaticVarGet( static_name_ + "scaleOutLongAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "scaleOutLongAlgo_barvalue" ) != lasttime )
    {
        if( ScaleOutMode == "Percentage" )
            ScaleOrder( "SELL", ScaleOutPct, 0 );
        else
            ScaleOrder( "SELL", 0, ScaleOutLots * RoundLotSize );

        StaticVarSetText( static_name_ + "scaleOutLongAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "scaleOutLongAlgo",          1 );
    }
    else
        if( NOT AlgoScaleOutLong )
        {
            StaticVarSet(     static_name_ + "scaleOutLongAlgo",          0 );
            StaticVarSetText( static_name_ + "scaleOutLongAlgo_barvalue", "" );
        }

    //  Scale Out – Short Position  (Short == sigScaleOut) 
    if( ScaleOutMode != "Disable" AND AlgoScaleOutShort AND
            StaticVarGet( static_name_ + "scaleOutShortAlgo" ) == 0 AND
            StaticVarGetText( static_name_ + "scaleOutShortAlgo_barvalue" ) != lasttime )
    {
        if( ScaleOutMode == "Percentage" )
            ScaleOrder( "BUY", ScaleOutPct, 0 );
        else
            ScaleOrder( "BUY", 0, ScaleOutLots * RoundLotSize );

        StaticVarSetText( static_name_ + "scaleOutShortAlgo_barvalue", lasttime );
        StaticVarSet(     static_name_ + "scaleOutShortAlgo",          1 );
    }
    else
        if( NOT AlgoScaleOutShort )
        {
            StaticVarSet(     static_name_ + "scaleOutShortAlgo",          0 );
            StaticVarSetText( static_name_ + "scaleOutShortAlgo_barvalue", "" );
        }
}

_SECTION_END();

